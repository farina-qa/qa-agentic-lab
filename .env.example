# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.
#
# The saucedemo credentials below are published openly on the site's login page.
# They are still handled as secrets here, because the habit is what matters:
# a real project's credentials must never reach a public repository.

BASE_URL=https://www.saucedemo.com

# Standard user: everything works as designed.
SAUCE_STANDARD_USER=
# Locked out user: login is rejected on purpose.
SAUCE_LOCKED_OUT_USER=
# Shared by every saucedemo account.
SAUCE_PASSWORD=
